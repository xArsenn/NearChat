{
  "name": "nearchat",
  "private": true,
  "version": "0.7.0",
  "description": "Bilingual serverless LAN chat and file collaboration with no-install phone guests",
  "author": "NearChat contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/xArsenn/NearChat.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable",
    "package:release": "npm run build && electron-builder --win nsis --config electron-builder.release.yml"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "chat.nearchat.desktop",
    "productName": "NearChat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
